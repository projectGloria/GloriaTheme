{
  "comments": { "lineComment": "//" },
  "brackets": [],
  "autoClosingPairs": [
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    { "open": "\"", "close": "\"" }
  ],
  "wordPattern": "[+-]?[A-Za-z_][A-Za-z0-9_.]*|[-+]?(?:[0-9]*\\.)?[0-9]+",
  "folding": {
    "markers": {
      "start": "^\\s*//\\s*#region\\b",
      "end": "^\\s*//\\s*#endregion\\b"
    }
  }
}
