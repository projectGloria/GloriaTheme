{
	"name": "gloria-theme",
	"displayName": "プロジェクト_Gloria",
	"description": "Luminous cyberpunk & retro-futuristic dark theme for VS Code featuring multi-layer neon glow, an interactive sidebar control panel, and Counter-Strike 2 syntax highlighting.",
	"version": "1.0.9",
	"icon": "nihilZone.jpg",
	"author": "Nihil",
	"publisher": "Nihilnia",
	"repository": {
		"type": "git",
		"url": "https://github.com/projectGloria/GloriaTheme.git"
	},
	"engines": {
		"vscode": "^1.82.0"
	},
	"scripts": {
		"test": "node --test test/*.test.js",
		"package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
		"vscode:uninstall": "node ./src/uninstall.js"
	},
	"extensionKind": [
		"ui"
	],
	"categories": [
		"Themes",
		"Programming Languages"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./src/extension.js",
	"contributes": {
		"languages": [{
			"id": "cs2-cfg",
			"aliases": ["Counter-Strike 2 Config", "CS2 CFG"],
			"filenames": ["autoexec.cfg"],
			"filenamePatterns": ["**/csgo/cfg/**/*.cfg", "**/730/local/cfg/*.cfg"],
			"configuration": "./language-configuration/cs2-cfg.json"
		}],
		"grammars": [{
			"language": "cs2-cfg",
			"scopeName": "source.cs2cfg",
			"path": "./syntaxes/cs2-cfg.tmLanguage.json"
		}],
		"themes": [
			{
				"label": "Gloria",
				"uiTheme": "vs-dark",
				"path": "./themes/gloria-color-theme.json"
			}
		],
		"icons": {
			"gloria-rabbit": {
				"description": "Gloria Rabbit Head Icon",
				"default": {
					"fontPath": "./assets/gloria-icons.woff",
					"fontCharacter": "\\E001"
				}
			}
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "gloria-sidebar",
					"title": "Gloria Theme",
					"icon": "./assets/rabbit.svg"
				}
			]
		},
		"views": {
			"gloria-sidebar": [
				{
					"type": "webview",
					"id": "gloria.controlPanelView",
					"name": "Control Panel",
					"icon": "./assets/rabbit.svg"
				}
			]
		},
		"commands": [
			{
				"command": "gloria.openControlPanel",
				"title": "Gloria: Open Theme Control Panel"
			},
			{
				"command": "gloria.resetColors",
				"title": "Gloria: Reset Theme Customizations"
			},
			{
				"command": "gloria.restoreWorkbench",
				"title": "Gloria: Restore VS Code Workbench"
			}
		],
		"configuration": {
			"title": "Gloria",
			"properties": {
				"gloria.enableWorkbench": {
					"type": "boolean",
					"default": true,
					"scope": "application",
					"description": "Enable the custom workbench skin and structural glow. Disable to restore VS Code's workbench files."
				},
				"gloria.brightness": {
					"type": "number",
					"scope": "application",
					"default": 0.45,
					"minimum": 0,
					"maximum": 1,
					"description": "Set the brightness value for the glow effect. 0.0 is fully transparent and 1.0 is fully bright"
				},
				"gloria.whiteGlowRadius": {
					"type": "number",
					"scope": "application",
					"default": 25,
					"minimum": 0,
					"maximum": 50,
					"description": "Outer white glow radius in pixels, independent of brightness."
				},
				"gloria.maxDecorationFileSize": {
					"type": "integer",
					"default": 1000000,
					"minimum": 0,
					"description": "Maximum document length in characters for structural decorations. Native syntax coloring remains available in larger files."
				},
				"gloria.disableGlow": {
					"type": "boolean",
					"scope": "application",
					"default": false,
					"description": "Disable the glow effect, but show editor chrome updates"
				}
			}
		}
	},
	"devDependencies": {
		"jsdom": "^30.1.3",
		"vscode-oniguruma": "^2.0.1",
		"vscode-textmate": "^9.3.2"
	}
}
